import customtkinter as ctk

root = ctk.CTk()

def select(btn):
    for b in buttons:
        b.configure(fg_color="gray")
    btn.configure(fg_color="blue")

buttons = []

for text, color in [("A", "red"), ("B", "green"), ("C", "blue")]:
    btn = ctk.CTkButton(root, text=text, fg_color=color, command=lambda b=text: print(b))
    btn.pack(side="left", padx=2)
    buttons.append(btn)

root.mainloop()